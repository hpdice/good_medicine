# =============================================================================
# AI 의약품 상호작용 분석 플랫폼 - 환경 변수 예시
# 이 파일을 복사하여 .env 를 만들고 실제 값을 입력하세요.
# .env 파일은 절대 git에 커밋하지 마세요!
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=drugtest_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=drugtest_db

# --- Application ---
# openssl rand -hex 32 로 생성
SECRET_KEY=your-256-bit-secret-key-here
FIELD_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here
DEBUG=false

# --- 공공데이터포털 API (data.go.kr) ---
PUBLIC_DATA_API_KEY=your-public-data-api-key-here

# --- FCM 푸시 알림 (선택 — 미설정 시 푸시 기능 비활성화) ---
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 후
# backend/firebase-service-account.json 으로 저장 (backend/ 가 컨테이너에 마운트되어 있음)
FIREBASE_CREDENTIALS_JSON=firebase-service-account.json

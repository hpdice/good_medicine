# 빌드 컨텍스트 = 레포 루트지만 이미지에 필요한 건 backend/ 뿐.
# (프론트 웹은 Vercel 이 빌드·호스팅하므로 front_app/ 은 통째로 제외)

# --- 버전관리/메타 ---
.git
.github
.claude
.gitignore
.dockerignore

# --- 프론트 (Vercel 담당, 이미지 불필요) ---
front_app

# --- 문서·부산물 ---
docs
archive
scripts
infrastructure
*.md
docker-compose*.yml

# --- 시크릿 (절대 이미지에 넣지 않음 — 실행 시 secrets/ 를 읽기 전용으로 연결) ---
secrets
**/.env
**/.env.*
**/firebase-service-account*.json

# --- Python 부산물 ---
**/__pycache__/
**/*.py[cod]
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/
*.dump
**/.venv/

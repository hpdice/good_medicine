# 빌드 컨텍스트 = 레포 루트. 이미지 빌드에 필요한 건 backend/ 와 front_app/(웹 빌드용)뿐.

# --- 버전관리/메타 ---
.git
.github
.claude
.gitignore
.dockerignore

# --- 문서·부산물 (이미지 불필요) ---
docs
archive
deploy
scripts
infrastructure
*.md
docker-compose*.yml

# --- 시크릿 (절대 이미지에 넣지 않음) ---
**/.env
**/.env.*
backend/firebase-service-account*.json

# --- Python ---
**/__pycache__/
**/*.py[cod]
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/
backend/tests/
*.dump

# --- Flutter: 웹 빌드에 lib/·web/·pubspec·assets 만 필요 ---
front_app/build/
front_app/.dart_tool/
front_app/.flutter-plugins
front_app/.flutter-plugins-dependencies
front_app/.pub-cache/
front_app/android/
front_app/ios/
front_app/linux/
front_app/macos/
front_app/windows/
front_app/test/
front_app/coverage/

# 줄바꿈 규칙 — 저장소에는 LF 로 저장하고, 체크아웃할 때만 OS 에 맞춘다.
# (개인 PC 의 core.autocrlf 설정에 기대지 않기 위해. CI(Linux)와 Windows 가 같은 결과를 보게 한다)
* text=auto

# 셸·컨테이너 안에서 실행되는 파일은 어디서든 LF
*.sh   text eol=lf
*.py   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# Windows PowerShell 스크립트는 CRLF (작업 스케줄러가 실행)
*.ps1  text eol=crlf

# 바이너리
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.jar    binary
*.dump   binary
*.joblib binary
